<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App extensions MUST adopt the sandbox or pkd refuses to register them. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Read the audio file the user shared from Voice Memos / Finder. -->
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <!-- Stage the copy into ~/.nota/inbox, the shared hand-off point the
       unsandboxed host app reads from. This path is deliberately NOT under
       ~/Documents: the exception below is scoped against the REAL home, and
       TCC (kTCCServiceSystemPolicyAppDataDetailed / Documents) would block
       one side or the other. ~/.nota is Nota's own state dir and is on none
       of TCC's protected lists, so the host can read what we write here.
       App Groups would be cleaner but require a Team ID; this ad-hoc build
       has none, so a home-relative temporary exception is used instead. -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
  <array>
    <string>/.nota/inbox/</string>
  </array>
</dict>
</plist>
